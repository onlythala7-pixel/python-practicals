class EventQueue:
  
  def __init__(self):

    self.queue = []

# Add a new event  
  def add_event(self):  
    event = input("Enter event name: ")  
    self.queue.append(event)  
    print("Event added successfully!")  

# Process the oldest event  
  def process_event(self):  
      if len(self.queue) == 0:  
          print("No events to process.")  
      else:  
        
        event = self.queue.pop(0)  
        print("Processing event:", event)  

# Display pending events  
  def display_events(self):  
    
    if len(self.queue) == 0: 
      
      print("No pending events.")  
    else:  
      
      print("Pending Events:")  
      for event in self.queue:  
        
        print(event)  

# Cancel an event  
  def cancel_event(self):  
    
    event = input("Enter event name to cancel: ")  

    if event in self.queue:  
        self.queue.remove(event)  
        print("Event cancelled successfully!")  
    else:  
        print("Event not found.")



e = EventQueue()

while True:
  print("\n--- Real-Time Event Processing System ---")
  print("1. Add Event")
  print("2. Process Next Event")
  print("3. Display Pending Events")
  print("4. Cancel Event")
  print("5. Exit")

  choice = int(input("Enter your choice: "))  

  if choice == 1:  
    
    e.add_event()  

  elif choice == 2:  
    e.process_event()  

  elif choice == 3:  
    e.display_events()  

  elif choice == 4:  
    e.cancel_event()  

  elif choice == 5:  
    print("Exiting Event Processing System.")  
    break  

  else:  
    print("Invalid choice! Please try again.")
