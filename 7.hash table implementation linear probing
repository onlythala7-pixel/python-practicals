# Hash Table Implementation

SIZE = 10
EMPTY = None
DELETED = "DELETED"


class HashTable:

    # Constructor
    def __init__(self):
        self.table = [EMPTY] * SIZE

    # Hash Function
    def hash_function(self, key):
        return key % SIZE

    # Insert Operation
    def insert(self, key):

        index = self.hash_function(key)

        for i in range(SIZE):

            pos = (index + i) % SIZE

            if self.table[pos] == EMPTY or self.table[pos] == DELETED:
                self.table[pos] = key
                print("Key inserted at index:", pos)
                return

            if self.table[pos] == key:
                print("Key already exists.")
                return

        print("Hash table is full.")

    # Search Operation
    def search(self, key):

        index = self.hash_function(key)

        for i in range(SIZE):

            pos = (index + i) % SIZE

            if self.table[pos] == EMPTY:
                print("Key not found.")
                return

            if self.table[pos] == key:
                print("Key found at index:", pos)
                return

        print("Key not found.")

    # Delete Operation
    def delete(self, key):

        index = self.hash_function(key)

        for i in range(SIZE):

            pos = (index + i) % SIZE

            if self.table[pos] == EMPTY:
                print("Key not found.")
                return

            if self.table[pos] == key:
                self.table[pos] = DELETED
                print("Key deleted.")
                return

        print("Key not found.")

    # Display Operation
    def display(self):

        print("\nHash Table:")

        for i in range(SIZE):

            if self.table[i] == EMPTY:
                print(i, ": Empty")

            elif self.table[i] == DELETED:
                print(i, ": Deleted")

            else:
                print(i, ":", self.table[i])


# Main Program

ht = HashTable()

while True:

    print("\n--- Hash Table Menu ---")
    print("1. Insert")
    print("2. Search")
    print("3. Delete")
    print("4. Display")
    print("5. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        key = int(input("Enter key: "))
        ht.insert(key)

    elif choice == 2:
        key = int(input("Enter key to search: "))
        ht.search(key)

    elif choice == 3:
        key = int(input("Enter key to delete: "))
        ht.delete(key)

    elif choice == 4:
        ht.display()

    elif choice == 5:
        print("Program ended.")
        break

    else:
        print("Invalid choice.")
